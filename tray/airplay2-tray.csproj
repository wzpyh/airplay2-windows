<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tray icon for the receiver: shows what the iPhone is playing and sends play/pause/next/previous
    back to it. Talks to shairport-sync over loopback UDP only:
      127.0.0.1:5555  metadata from shairport-sync (metadata.socket_* in shairport-sync.conf)
      127.0.0.1:5557  remote-control words to shairport-sync (patches/shairport-sync-remote.patch)
    Build: dotnet publish tray -c Release -o dist/tray
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>airplay2-tray</AssemblyName>
    <RootNamespace>AirPlayTray</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>none</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- no package references; .NET 10's package pruning fails restore on the GitHub runner
         ("Failed to load prune package data", MSB4181) -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <!-- FileDescription: the app name Windows shows on its media controls -->
    <AssemblyTitle>AirPlay</AssemblyTitle>
    <ApplicationIcon>airplay.ico</ApplicationIcon>
    <Product>airplay2-windows</Product>
  </PropertyGroup>
</Project>
