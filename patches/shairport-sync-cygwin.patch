diff --git a/mdns_winpipe.c b/mdns_winpipe.c
new file mode 100644
index 0000000..117dda8
--- /dev/null
+++ b/mdns_winpipe.c
@@ -0,0 +1,83 @@
+/*
+ * mDNS backend for Windows (Cygwin/MSYS2 builds): hands the service records to an
+ * external native publisher (mdns-pub.exe, built from UxPlay's lib/mdnsd) over a pipe.
+ * Local patch -- not part of upstream Shairport Sync.
+ *
+ * Line protocol (one line per registration or update):
+ *   S \t <ap2 name> \t <ap1 name> \t <port> \t <ap1 txt count> \t <ap1 k=v>... \t <ap2 k=v>...
+ * Closing the pipe makes the publisher send goodbye packets and exit.
+ */
+
+#include "common.h"
+#include "mdns.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static FILE *publisher = NULL;
+static char *saved_ap1name = NULL;
+static char *saved_ap2name = NULL;
+static int saved_port = 0;
+
+static int count_records(char **records) {
+  int n = 0;
+  if (records)
+    while (records[n])
+      n++;
+  return n;
+}
+
+static int send_records(char **txt_records, char **secondary_txt_records) {
+  if (publisher == NULL)
+    return -1;
+  int n1 = count_records(txt_records);
+  fprintf(publisher, "S\t%s\t%s\t%d\t%d", saved_ap2name ? saved_ap2name : saved_ap1name,
+          saved_ap1name, saved_port, n1);
+  for (int i = 0; i < n1; i++)
+    fprintf(publisher, "\t%s", txt_records[i]);
+  int n2 = count_records(secondary_txt_records);
+  for (int i = 0; i < n2; i++)
+    fprintf(publisher, "\t%s", secondary_txt_records[i]);
+  fprintf(publisher, "\n");
+  if (fflush(publisher) != 0) {
+    warn("mdns_winpipe: could not write to the publisher.");
+    return -1;
+  }
+  debug(1, "mdns_winpipe: sent %d AirPlay 1 and %d AirPlay 2 TXT entries.", n1, n2);
+  return 0;
+}
+
+static int mdns_winpipe_register(char *ap1name, char *ap2name, int port, char **txt_records,
+                                 char **secondary_txt_records) {
+  const char *exe = getenv("SPS_MDNS_PUBLISHER");
+  if (exe == NULL)
+    exe = "mdns-pub.exe"; // found via PATH (run.sh puts it there)
+  publisher = popen(exe, "w");
+  if (publisher == NULL) {
+    warn("mdns_winpipe: could not start the publisher \"%s\".", exe);
+    return -1;
+  }
+  saved_ap1name = strdup(ap1name);
+  saved_ap2name = ap2name ? strdup(ap2name) : NULL;
+  saved_port = port;
+  return send_records(txt_records, secondary_txt_records);
+}
+
+static int mdns_winpipe_update(char **txt_records, char **secondary_txt_records) {
+  return send_records(txt_records, secondary_txt_records);
+}
+
+static void mdns_winpipe_unregister(void) {
+  if (publisher) {
+    pclose(publisher);
+    publisher = NULL;
+  }
+}
+
+mdns_backend mdns_winpipe = {.name = "winpipe",
+                             .mdns_register = mdns_winpipe_register,
+                             .mdns_update = mdns_winpipe_update,
+                             .mdns_unregister = mdns_winpipe_unregister,
+                             .mdns_dacp_monitor_start = NULL,
+                             .mdns_dacp_monitor_set_id = NULL,
+                             .mdns_dacp_monitor_stop = NULL};
