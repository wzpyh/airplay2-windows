+/*
+ * WASAPI (Windows) output backend for Shairport Sync, for Cygwin/MSYS2 builds.
+ * Local patch from airplay2-windows -- not part of upstream Shairport Sync.
+ *
+ * Plays in shared mode to the device named by wasapi.output_device, or to the default render
+ * device if that is not set or not active. The engine converts the stream to the device mix
+ * format (AUTOCONVERTPCM), so only S16_LE/S32_LE stereo at 44.1/48 kHz is offered.
+ * delay() reports frames still queued in the endpoint buffer plus the stream latency, which is
+ * what Shairport Sync needs to keep output in sync with the AirPlay (PTP) clock.
+ * Device changes (default changed, device plugged in or unplugged) are reported by an
+ * IMMNotificationClient; the next play() then moves the stream to the device that should be used
+ * now. If the device goes away, the next play() reopens the right one too.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy of this software
+ * and associated documentation files (the "Software"), to deal in the Software without
+ * restriction, including without limitation the rights to use, copy, modify, merge, publish,
+ * distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions: the above copyright notice
+ * and this permission notice shall be included in all copies or substantial portions of the
+ * Software. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
+ */
+
+#include "audio.h"
+#include "common.h"
+#include <ctype.h>
+#include <errno.h>
+#include <pthread.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+#include <wchar.h>
+
+#define COBJMACROS
+#include <windows.h>
+#include <initguid.h>
+#include <audioclient.h>
+#include <mmdeviceapi.h>
+
+DEFINE_GUID(sps_CLSID_MMDeviceEnumerator, 0xBCDE0395, 0xE52F, 0x467C, 0x8E, 0x3D, 0xC4, 0x57, 0x92,
+            0x91, 0x69, 0x2E);
+DEFINE_GUID(sps_IID_IMMDeviceEnumerator, 0xA95664D2, 0x9614, 0x4F35, 0xA7, 0x46, 0xDE, 0x8D, 0xB6,
+            0x36, 0x17, 0xE6);
+DEFINE_GUID(sps_IID_IAudioClient, 0x1CB9AD4C, 0xDBFA, 0x4C32, 0xB1, 0x78, 0xC2, 0xF5, 0x68, 0xA7,
+            0x03, 0xB2);
+DEFINE_GUID(sps_IID_IAudioRenderClient, 0xF294ACFC, 0x3146, 0x4483, 0xA7, 0xBF, 0xAD, 0xDC, 0xA7,
+            0xC2, 0x60, 0xE2);
+DEFINE_GUID(sps_IID_IUnknown, 0x00000000, 0x0000, 0x0000, 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+            0x46);
+DEFINE_GUID(sps_IID_IMMNotificationClient, 0x7991EEC9, 0x7E89, 0x4D85, 0x83, 0x90, 0x6C, 0x70, 0x3C,
+            0xEC, 0x60, 0xC0);
+// PKEY_Device_FriendlyName, e.g. "Headphones (AMD Audio Device)"
+static const PROPERTYKEY sps_PKEY_Device_FriendlyName = {
+    {0xA45C254E, 0xDF1C, 0x4EFD, {0x80, 0x20, 0x67, 0xD1, 0x46, 0xA8, 0x50, 0xE0}}, 14};
+
+#define DEVICE_BUFFER_SECONDS 1.0
+
+static pthread_mutex_t wasapi_mutex = PTHREAD_MUTEX_INITIALIZER;
+static IAudioClient *client = NULL;
+static IAudioRenderClient *render = NULL;
+static UINT32 buffer_frames = 0;
+static UINT32 latency_frames = 0; // stream latency reported by the engine
+static int running = 0;
+static int32_t current_encoded_output_format = 0;
+static unsigned int frame_bytes = 0;
+static char *preferred_device = NULL; // wasapi.output_device, NULL = the default device
+static LPWSTR current_device_id = NULL; // endpoint id of the open stream
+static volatile LONG device_check_needed = 0; // set by the notification client
+static IMMDeviceEnumerator *notify_enumerator = NULL;
+
+static void com_init_thread(void) {
+  // COINIT_MULTITHREADED: the objects are shared by the player and the RTSP threads.
+  // Returns S_FALSE if already initialised on this thread, which is fine.
+  CoInitializeEx(NULL, COINIT_MULTITHREADED);
+}
+
+// Endpoint notifications arrive on a thread of the audio service. They only raise a flag: the
+// audio client must not be touched from inside the callback.
+static HRESULT STDMETHODCALLTYPE nc_query_interface(IMMNotificationClient *this, REFIID riid,
+                                                    void **object) {
+  if (IsEqualIID(riid, &sps_IID_IUnknown) || IsEqualIID(riid, &sps_IID_IMMNotificationClient)) {
+    *object = this;
+    return S_OK;
+  }
+  *object = NULL;
+  return E_NOINTERFACE;
+}
+static ULONG STDMETHODCALLTYPE nc_add_ref(__attribute__((unused)) IMMNotificationClient *this) {
+  return 1; // static object
+}
+static ULONG STDMETHODCALLTYPE nc_release(__attribute__((unused)) IMMNotificationClient *this) {
+  return 1;
+}
+static HRESULT STDMETHODCALLTYPE nc_device_state_changed(
+    __attribute__((unused)) IMMNotificationClient *this, __attribute__((unused)) LPCWSTR id,
+    __attribute__((unused)) DWORD state) {
+  InterlockedExchange(&device_check_needed, 1);
+  return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE nc_device_added(__attribute__((unused)) IMMNotificationClient *this,
+                                                 __attribute__((unused)) LPCWSTR id) {
+  InterlockedExchange(&device_check_needed, 1);
+  return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE nc_device_removed(
+    __attribute__((unused)) IMMNotificationClient *this, __attribute__((unused)) LPCWSTR id) {
+  InterlockedExchange(&device_check_needed, 1);
+  return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE nc_default_device_changed(
+    __attribute__((unused)) IMMNotificationClient *this, EDataFlow flow, ERole role,
+    __attribute__((unused)) LPCWSTR id) {
+  if (flow == eRender && role == eConsole)
+    InterlockedExchange(&device_check_needed, 1);
+  return S_OK;
+}
+static HRESULT STDMETHODCALLTYPE nc_property_value_changed(
+    __attribute__((unused)) IMMNotificationClient *this, __attribute__((unused)) LPCWSTR id,
+    __attribute__((unused)) const PROPERTYKEY key) {
+  return S_OK; // fires constantly (volume, levels); not interesting
+}
+static IMMNotificationClientVtbl notify_vtbl = {
+    .QueryInterface = nc_query_interface,
+    .AddRef = nc_add_ref,
+    .Release = nc_release,
+    .OnDeviceStateChanged = nc_device_state_changed,
+    .OnDeviceAdded = nc_device_added,
+    .OnDeviceRemoved = nc_device_removed,
+    .OnDefaultDeviceChanged = nc_default_device_changed,
+    .OnPropertyValueChanged = nc_property_value_changed};
+static IMMNotificationClient notify_client = {.lpVtbl = &notify_vtbl};
+
+// UTF-8 copy of a wide string; free() it.
+static char *utf8_from_wide(LPCWSTR wide) {
+  int n = WideCharToMultiByte(CP_UTF8, 0, wide, -1, NULL, 0, NULL, NULL);
+  char *s = n > 0 ? malloc(n) : NULL;
+  if (s)
+    WideCharToMultiByte(CP_UTF8, 0, wide, -1, s, n, NULL, NULL);
+  return s;
+}
+
+// Friendly name of an endpoint, UTF-8; free() it. NULL if it has none.
+static char *device_name(IMMDevice *device) {
+  char *name = NULL;
+  IPropertyStore *props = NULL;
+  if (SUCCEEDED(IMMDevice_OpenPropertyStore(device, STGM_READ, &props))) {
+    PROPVARIANT value;
+    PropVariantInit(&value);
+    if (SUCCEEDED(IPropertyStore_GetValue(props, &sps_PKEY_Device_FriendlyName, &value)) &&
+        value.vt == VT_LPWSTR)
+      name = utf8_from_wide(value.pwszVal);
+    PropVariantClear(&value);
+    IPropertyStore_Release(props);
+  }
+  return name;
+}
+
+// Case-insensitive (ASCII) substring test.
+static int contains_nocase(const char *haystack, const char *needle) {
+  size_t n = strlen(needle);
+  for (; *haystack; haystack++) {
+    size_t i = 0;
+    while (i < n && haystack[i] &&
+           tolower((unsigned char)haystack[i]) == tolower((unsigned char)needle[i]))
+      i++;
+    if (i == n)
+      return 1;
+  }
+  return n == 0;
+}
+
+// The active endpoint that wasapi.output_device names: an exact endpoint id or friendly name
+// first, else the first friendly name that contains it. NULL if none matches; then the list of
+// active devices is logged so the right name can be put in the configuration.
+static IMMDevice *find_preferred_device(IMMDeviceEnumerator *enumerator) {
+  IMMDeviceCollection *devices = NULL;
+  IMMDevice *exact = NULL, *partial = NULL;
+  UINT count = 0;
+  if (FAILED(IMMDeviceEnumerator_EnumAudioEndpoints(enumerator, eRender, DEVICE_STATE_ACTIVE,
+                                                    &devices)))
+    return NULL;
+  IMMDeviceCollection_GetCount(devices, &count);
+  for (UINT i = 0; i < count && exact == NULL; i++) {
+    IMMDevice *device = NULL;
+    if (FAILED(IMMDeviceCollection_Item(devices, i, &device)))
+      continue;
+    LPWSTR wide_id = NULL;
+    char *id = NULL;
+    if (SUCCEEDED(IMMDevice_GetId(device, &wide_id))) {
+      id = utf8_from_wide(wide_id);
+      CoTaskMemFree(wide_id);
+    }
+    char *name = device_name(device);
+    if ((id && strcasecmp(id, preferred_device) == 0) ||
+        (name && strcasecmp(name, preferred_device) == 0)) {
+      exact = device;
+    } else if (partial == NULL && name && contains_nocase(name, preferred_device)) {
+      partial = device;
+    } else {
+      IMMDevice_Release(device);
+    }
+    free(id);
+    free(name);
+  }
+  if (exact && partial)
+    IMMDevice_Release(partial);
+  IMMDevice *found = exact ? exact : partial;
+  if (found == NULL) {
+    warn("wasapi: no active output device matches output_device \"%s\"; using the default device. "
+         "Active devices:",
+         preferred_device);
+    for (UINT i = 0; i < count; i++) {
+      IMMDevice *device = NULL;
+      if (FAILED(IMMDeviceCollection_Item(devices, i, &device)))
+        continue;
+      char *name = device_name(device);
+      warn("wasapi:   \"%s\"", name ? name : "(no name)");
+      free(name);
+      IMMDevice_Release(device);
+    }
+  }
+  IMMDeviceCollection_Release(devices);
+  return found;
+}
+
+// The device the stream should be on right now: the configured one if it is active, else the
+// default render device. NULL if there is no output device at all.
+static IMMDevice *find_output_device(void) {
+  IMMDeviceEnumerator *enumerator = NULL;
+  IMMDevice *device = NULL;
+  HRESULT hr = CoCreateInstance(&sps_CLSID_MMDeviceEnumerator, NULL, CLSCTX_ALL,
+                                &sps_IID_IMMDeviceEnumerator, (void **)&enumerator);
+  if (FAILED(hr)) {
+    warn("wasapi: cannot enumerate audio devices (hr=0x%08lx).", (unsigned long)hr);
+    return NULL;
+  }
+  if (preferred_device)
+    device = find_preferred_device(enumerator);
+  if (device == NULL) {
+    hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(enumerator, eRender, eConsole, &device);
+    if (FAILED(hr)) {
+      warn("wasapi: no default audio output device (hr=0x%08lx).", (unsigned long)hr);
+      device = NULL;
+    }
+  }
+  IMMDeviceEnumerator_Release(enumerator);
+  return device;
+}
+
+static void release_device(void) {
+  if (render) {
+    IAudioRenderClient_Release(render);
+    render = NULL;
+  }
+  if (client) {
+    IAudioClient_Stop(client);
+    IAudioClient_Release(client);
+    client = NULL;
+  }
+  if (current_device_id) {
+    CoTaskMemFree(current_device_id);
+    current_device_id = NULL;
+  }
+  running = 0;
+}
+
+// Open the output device for the current output format. Caller holds wasapi_mutex.
+static int open_device(void) {
+  com_init_thread();
+  release_device();
+  InterlockedExchange(&device_check_needed, 0);
+  if (current_encoded_output_format == 0)
+    return -1;
+
+  unsigned int rate = RATE_FROM_ENCODED_FORMAT(current_encoded_output_format);
+  unsigned int channels = CHANNELS_FROM_ENCODED_FORMAT(current_encoded_output_format);
+  sps_format_t format = FORMAT_FROM_ENCODED_FORMAT(current_encoded_output_format);
+  unsigned int bits = format == SPS_FORMAT_S32_LE ? 32 : 16;
+  frame_bytes = channels * bits / 8;
+
+  IMMDevice *device = find_output_device();
+  if (device == NULL)
+    return -1;
+  char *name = device_name(device);
+  HRESULT hr = IMMDevice_GetId(device, &current_device_id);
+  if (FAILED(hr))
+    current_device_id = NULL;
+  hr = IMMDevice_Activate(device, &sps_IID_IAudioClient, CLSCTX_ALL, NULL, (void **)&client);
+  IMMDevice_Release(device);
+  if (FAILED(hr)) {
+    warn("wasapi: cannot open output device \"%s\" (hr=0x%08lx).", name ? name : "?",
+         (unsigned long)hr);
+    free(name);
+    client = NULL;
+    release_device();
+    return -1;
+  }
+
+  WAVEFORMATEX fmt;
+  memset(&fmt, 0, sizeof(fmt));
+  fmt.wFormatTag = WAVE_FORMAT_PCM;
+  fmt.nChannels = (WORD)channels;
+  fmt.nSamplesPerSec = rate;
+  fmt.wBitsPerSample = (WORD)bits;
+  fmt.nBlockAlign = (WORD)frame_bytes;
+  fmt.nAvgBytesPerSec = rate * frame_bytes;
+
+  hr = IAudioClient_Initialize(
+      client, AUDCLNT_SHAREMODE_SHARED,
+      AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM | AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY,
+      (REFERENCE_TIME)(DEVICE_BUFFER_SECONDS * 10000000), 0, &fmt, NULL);
+  if (SUCCEEDED(hr))
+    hr = IAudioClient_GetBufferSize(client, &buffer_frames);
+  if (SUCCEEDED(hr))
+    hr = IAudioClient_GetService(client, &sps_IID_IAudioRenderClient, (void **)&render);
+  if (FAILED(hr)) {
+    warn("wasapi: could not open the output stream on \"%s\" (hr=0x%08lx).", name ? name : "?",
+         (unsigned long)hr);
+    free(name);
+    release_device();
+    return -1;
+  }
+  REFERENCE_TIME latency = 0;
+  IAudioClient_GetStreamLatency(client, &latency);
+  latency_frames = (UINT32)((uint64_t)latency * rate / 10000000);
+  inform("wasapi: playing to \"%s\", %s, buffer %u frames, stream latency %u frames.",
+         name ? name : "?", short_format_description(current_encoded_output_format),
+         buffer_frames, latency_frames);
+  free(name);
+  return 0;
+}
+
+// After a device notification: move the stream if it is no longer on the device it should be
+// on. Caller holds wasapi_mutex and has an open stream.
+static void follow_device_change(void) {
+  IMMDevice *device = find_output_device();
+  LPWSTR id = NULL;
+  int same = 0;
+  if (device) {
+    if (SUCCEEDED(IMMDevice_GetId(device, &id))) {
+      same = current_device_id && wcscmp(id, current_device_id) == 0;
+      CoTaskMemFree(id);
+    }
+    IMMDevice_Release(device);
+  }
+  if (!same)
+    open_device();
+}
+
+static int check_configuration(unsigned int channels, unsigned int rate, unsigned int format) {
+  if (channels != 2)
+    return EINVAL;
+  if (rate != 44100 && rate != 48000)
+    return EINVAL;
+  if (format != SPS_FORMAT_S16_LE && format != SPS_FORMAT_S32_LE)
+    return EINVAL;
+  return 0;
+}
+
+static int32_t get_configuration(unsigned int channels, unsigned int rate, unsigned int format) {
+  return search_for_suitable_configuration(channels, rate, format, &check_configuration);
+}
+
+static int configure(int32_t requested_encoded_format, char **channel_map) {
+  pthread_mutex_lock(&wasapi_mutex);
+  int response = 0;
+  if (requested_encoded_format != current_encoded_output_format) {
+    current_encoded_output_format = requested_encoded_format;
+    response = open_device();
+  }
+  pthread_mutex_unlock(&wasapi_mutex);
+  if (channel_map != NULL)
+    *channel_map = NULL;
+  return response;
+}
+
+static int init(__attribute__((unused)) int argc, __attribute__((unused)) char **argv) {
+  config.audio_backend_buffer_desired_length = 0.2;
+  config.audio_backend_buffer_interpolation_threshold_in_seconds = 0.12;
+  config.audio_backend_latency_offset = 0;
+  parse_audio_options("wasapi", (1 << SPS_FORMAT_S16_LE) | (1 << SPS_FORMAT_S32_LE),
+                      (1 << SPS_RATE_44100) | (1 << SPS_RATE_48000), (1 << 2));
+  const char *str;
+  if (config.cfg != NULL && config_lookup_non_empty_string(config.cfg, "wasapi.output_device", &str)) {
+    preferred_device = strdup(str);
+    inform("wasapi: output_device is \"%s\".", preferred_device);
+  }
+  com_init_thread();
+  HRESULT hr = CoCreateInstance(&sps_CLSID_MMDeviceEnumerator, NULL, CLSCTX_ALL,
+                                &sps_IID_IMMDeviceEnumerator, (void **)&notify_enumerator);
+  if (SUCCEEDED(hr))
+    hr = IMMDeviceEnumerator_RegisterEndpointNotificationCallback(notify_enumerator,
+                                                                  &notify_client);
+  if (FAILED(hr))
+    warn("wasapi: cannot watch for audio device changes (hr=0x%08lx).", (unsigned long)hr);
+  return 0;
+}
+
+static void deinit(void) {
+  if (notify_enumerator) {
+    IMMDeviceEnumerator_UnregisterEndpointNotificationCallback(notify_enumerator, &notify_client);
+    IMMDeviceEnumerator_Release(notify_enumerator);
+    notify_enumerator = NULL;
+  }
+  pthread_mutex_lock(&wasapi_mutex);
+  release_device();
+  pthread_mutex_unlock(&wasapi_mutex);
+}
+
+static int play(void *buf, int frames, __attribute__((unused)) int sample_type,
+                __attribute__((unused)) uint32_t timestamp,
+                __attribute__((unused)) uint64_t playtime) {
+  pthread_mutex_lock(&wasapi_mutex);
+  com_init_thread();
+  if (client != NULL && InterlockedExchange(&device_check_needed, 0))
+    follow_device_change();
+  if (client == NULL && open_device() != 0) {
+    pthread_mutex_unlock(&wasapi_mutex);
+    return 0; // drop the audio; the next block retries the device
+  }
+  int written = 0;
+  while (written < frames) {
+    UINT32 padding = 0;
+    HRESULT hr = IAudioClient_GetCurrentPadding(client, &padding);
+    if (hr == AUDCLNT_E_DEVICE_INVALIDATED) {
+      warn("wasapi: the output device went away; reopening.");
+      if (open_device() != 0)
+        break;
+      continue;
+    }
+    UINT32 room = buffer_frames - padding;
+    if (room == 0) {
+      // the buffer is full: let it drain a little without holding the lock
+      pthread_mutex_unlock(&wasapi_mutex);
+      usleep(2000);
+      pthread_mutex_lock(&wasapi_mutex);
+      if (client == NULL)
+        break;
+      continue;
+    }
+    UINT32 n = (UINT32)(frames - written) < room ? (UINT32)(frames - written) : room;
+    BYTE *dst = NULL;
+    hr = IAudioRenderClient_GetBuffer(render, n, &dst);
+    if (FAILED(hr)) {
+      debug(1, "wasapi: GetBuffer failed (hr=0x%08lx).", (unsigned long)hr);
+      break;
+    }
+    memcpy(dst, (char *)buf + (size_t)written * frame_bytes, (size_t)n * frame_bytes);
+    IAudioRenderClient_ReleaseBuffer(render, n, 0);
+    written += n;
+    if (!running) {
+      IAudioClient_Start(client);
+      running = 1;
+    }
+  }
+  pthread_mutex_unlock(&wasapi_mutex);
+  return 0;
+}
+
+static int delay(long *the_delay) {
+  pthread_mutex_lock(&wasapi_mutex);
+  com_init_thread();
+  int response = 0;
+  UINT32 padding = 0;
+  if (client == NULL || !running) {
+    *the_delay = 0;
+  } else if (FAILED(IAudioClient_GetCurrentPadding(client, &padding))) {
+    *the_delay = 0;
+    response = -EIO;
+  } else {
+    *the_delay = (long)padding + (long)latency_frames;
+  }
+  pthread_mutex_unlock(&wasapi_mutex);
+  return response;
+}
+
+static void flush(void) {
+  pthread_mutex_lock(&wasapi_mutex);
+  com_init_thread();
+  if (client) {
+    IAudioClient_Stop(client);
+    IAudioClient_Reset(client);
+  }
+  running = 0;
+  pthread_mutex_unlock(&wasapi_mutex);
+}
+
+static void stop(void) { flush(); }
+
+static void help(void) {
+  printf("    The wasapi backend plays to the Windows default audio device and follows it when it\n"
+         "    changes. To always use one device, set output_device in the \"wasapi\" section to its\n"
+         "    name as Windows shows it, e.g. \"Headphones (AMD Audio Device)\", or a part of the\n"
+         "    name; when that device is not active the default device is used.\n");
+}
+
+// Remember the AirPlay volume across restarts in the file named by SPS_VOLUME_FILE.
+// Mute (-144) is not saved, so a restart never comes back muted.
+void wasapi_save_volume(double airplay_volume) {
+  const char *path = getenv("SPS_VOLUME_FILE");
+  if (path == NULL || airplay_volume < -30.0 || airplay_volume > 0.0)
+    return;
+  FILE *f = fopen(path, "w");
+  if (f) {
+    fprintf(f, "%.3f\n", airplay_volume);
+    fclose(f);
+  }
+}
+
+void wasapi_load_volume(double *airplay_volume) {
+  const char *path = getenv("SPS_VOLUME_FILE");
+  double v;
+  FILE *f = path ? fopen(path, "r") : NULL;
+  if (f == NULL)
+    return;
+  if (fscanf(f, "%lf", &v) == 1 && v >= -30.0 && v <= 0.0) {
+    *airplay_volume = v;
+    debug(1, "wasapi: restored the last AirPlay volume, %.3f.", v);
+  }
+  fclose(f);
+}
+
+audio_output audio_wasapi = {.name = "wasapi",
+                             .help = &help,
+                             .init = &init,
+                             .deinit = &deinit,
+                             .prepare = NULL,
+                             .get_configuration = &get_configuration,
+                             .configure = &configure,
+                             .play = &play,
+                             .stop = &stop,
+                             .is_running = NULL,
+                             .flush = &flush,
+                             .delay = &delay,
+                             .stats = NULL,
+                             .volume = NULL,
+                             .parameters = NULL,
+                             .mute = NULL};
