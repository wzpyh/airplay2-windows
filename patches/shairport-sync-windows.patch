diff --git a/mdns_uxmdnsd.c b/mdns_uxmdnsd.c
new file mode 100644
index 0000000..258bb8c
--- /dev/null
+++ b/mdns_uxmdnsd.c
@@ -0,0 +1,107 @@
+/*
+ * In-process mDNS backend for Windows (Cygwin/MSYS2) builds, using the minimal mDNS responder
+ * from UxPlay (lib/mdnsd, LGPL-2.1, copied into uxplay/ at build time).
+ * Local patch from airplay2-windows -- not part of upstream Shairport Sync.
+ *
+ * Windows has no Avahi, and tinysvcmdns cannot advertise the AirPlay 2 service; this backend
+ * publishes both _airplay._tcp (AirPlay 2) and _raop._tcp (AirPlay 1) records and answers queries
+ * from its own thread.
+ */
+
+#include "common.h"
+#include "mdns.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "uxplay/mdnsd/mdnsd.h"
+
+static mdnsd_t *responder = NULL;
+static mdnsd_service_t airplay_service, raop_service;
+static char saved_ap1name[MDNSD_MAX_NAME];
+static char saved_ap2name[MDNSD_MAX_NAME];
+static int saved_port = 0;
+
+static void fill_txt(mdnsd_txt_t *txt, char **records) {
+  memset(txt, 0, sizeof(*txt));
+  for (int i = 0; records && records[i]; i++) {
+    char *kv = strdup(records[i]);
+    char *eq = strchr(kv, '=');
+    if (eq)
+      *eq = '\0';
+    if (mdnsd_txt_add(txt, kv, eq ? eq + 1 : "") != 0)
+      warn("mdns_uxmdnsd: TXT record full, dropped \"%s\".", records[i]);
+    free(kv);
+  }
+}
+
+static int publish(char **txt_records, char **secondary_txt_records) {
+  // txt_records go with the AirPlay 1 (_raop) service, secondary_txt_records with AirPlay 2
+  memset(&airplay_service, 0, sizeof(airplay_service));
+  snprintf(airplay_service.type, sizeof(airplay_service.type), "_airplay._tcp.local");
+  snprintf(airplay_service.name, sizeof(airplay_service.name), "%s._airplay._tcp.local",
+           saved_ap2name);
+  airplay_service.port = (unsigned short)saved_port;
+  airplay_service.registered = secondary_txt_records != NULL;
+  fill_txt(&airplay_service.txt, secondary_txt_records);
+
+  memset(&raop_service, 0, sizeof(raop_service));
+  snprintf(raop_service.type, sizeof(raop_service.type), "_raop._tcp.local");
+  snprintf(raop_service.name, sizeof(raop_service.name), "%s._raop._tcp.local", saved_ap1name);
+  raop_service.port = (unsigned short)saved_port;
+  raop_service.registered = 1;
+  fill_txt(&raop_service.txt, txt_records);
+
+  mdnsd_set_services(responder, &airplay_service, &raop_service);
+  mdnsd_announce(responder, MDNSD_TTL_SERVICE);
+  debug(1, "mdns_uxmdnsd: announced \"%s\" and \"%s\" on port %d.", saved_ap2name, saved_ap1name,
+        saved_port);
+  return 0;
+}
+
+static int mdns_uxmdnsd_register(char *ap1name, char *ap2name, int port, char **txt_records,
+                                 char **secondary_txt_records) {
+  char host[MDNSD_MAX_NAME];
+  char name[MDNSD_MAX_NAME - 8] = "airplay2-windows";
+  gethostname(name, sizeof(name));
+  snprintf(host, sizeof(host), "%s.local", name);
+
+  responder = mdnsd_init(host);
+  if (responder == NULL || mdnsd_start(responder) != 0) {
+    warn("mdns_uxmdnsd: could not start the mDNS responder (is UDP port 5353 usable?).");
+    if (responder) {
+      mdnsd_destroy(responder);
+      responder = NULL;
+    }
+    return -1;
+  }
+  snprintf(saved_ap1name, sizeof(saved_ap1name), "%s", ap1name);
+  snprintf(saved_ap2name, sizeof(saved_ap2name), "%s", ap2name ? ap2name : ap1name);
+  saved_port = port;
+  return publish(txt_records, secondary_txt_records);
+}
+
+static int mdns_uxmdnsd_update(char **txt_records, char **secondary_txt_records) {
+  if (responder == NULL)
+    return -1;
+  return publish(txt_records, secondary_txt_records);
+}
+
+static void mdns_uxmdnsd_unregister(void) {
+  if (responder) {
+    mdnsd_goodbye(responder, &airplay_service);
+    mdnsd_goodbye(responder, &raop_service);
+    mdnsd_stop(responder);
+    mdnsd_destroy(responder);
+    responder = NULL;
+  }
+}
+
+mdns_backend mdns_uxmdnsd = {.name = "uxmdnsd",
+                             .mdns_register = mdns_uxmdnsd_register,
+                             .mdns_update = mdns_uxmdnsd_update,
+                             .mdns_unregister = mdns_uxmdnsd_unregister,
+                             .mdns_dacp_monitor_start = NULL,
+                             .mdns_dacp_monitor_set_id = NULL,
+                             .mdns_dacp_monitor_stop = NULL};
