// Generated by install.ps1 from config/shairport-sync.conf.in -- edit the template, then re-run install.ps1.
general = {
  name = "@NAME@";
  port = @PORT@;
  output_backend = "stdout";   // raw PCM to stdout, played by GStreamer (see runtime/run.sh)
  mdns_backend = "winpipe";    // advertised by mdns-pub.exe (patches/shairport-sync-cygwin.patch)
};

stdout = {
  output_format = "S16_LE";    // must match the rawaudioparse caps in runtime/run.sh
  output_rate = 44100;
};
