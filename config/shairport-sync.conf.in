// Generated by install.ps1 from config/shairport-sync.conf.in -- edit the template, then re-run install.ps1.
general = {
  name = "@NAME@";
  port = @PORT@;
  output_backend = "wasapi";   // Windows audio output (patches/shairport-sync-windows.patch)
  mdns_backend = "uxmdnsd";    // built-in mDNS responder (UxPlay lib/mdnsd)
};
wasapi = {
  output_device = "@OUTPUT_DEVICE@";   // empty: the Windows default device, followed when it changes
};
